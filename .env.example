# ─────────────────────────────────────────────────────────────────
# Traydstream – Environment Variables (copy to .env)
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=traydstream
POSTGRES_USER=traydstream
POSTGRES_PASSWORD=traydstream_secret
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ── Backend (Spring Boot) ────────────────────────────────────────
BACKEND_PORT=8080
JWT_SECRET=traydstream_jwt_super_secret_key_must_be_at_least_256_bits_long_for_hs256
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
UPLOAD_DIR=/app/uploads

# ── AI Service (FastAPI) ─────────────────────────────────────────
AI_SERVICE_PORT=8000

# ── Frontend (Vite) ──────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AI_SERVICE_URL=http://localhost:8000
